# Enable only after receiver, delivery, assessment terms and privacy copy are approved.
LEAD_INTAKE_ENABLED=false
RESEND_API_KEY=
LEAD_FROM=
LEAD_RECIPIENT=

# Calculator delivery additionally requires private durable object storage.
# Choose/approve the provider and retention before enabling. Do not use NEXT_PUBLIC_.
QUOTE_S3_ENDPOINT=
QUOTE_S3_REGION=
QUOTE_S3_BUCKET=
QUOTE_S3_ACCESS_KEY_ID=
QUOTE_S3_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials:
QUOTE_S3_SESSION_TOKEN=
# Random secret of at least 32 characters (server only):
QUOTE_SESSION_SECRET=
# Enable only after measurement and privacy approval. No third-party analytics added.
QUOTE_ANALYTICS_ENABLED=false
